#!/bin/zsh
set -euo pipefail
SRC='/Volumes/数据盘/Codes/junior-subjects/初中/历史/九年级/最新【人教版】9年级历史历史•上册.pdf'
ROOT='/Volumes/数据盘/Codes/junior-subjects/初中/历史/九年级/最新【人教版】9年级历史历史•上册_按单元章节拆分'
rm -rf "$ROOT"
mkdir -p "$ROOT"

split_pdf() {
  local folder="$1" filename="$2" range="$3"
  mkdir -p "$ROOT/$folder"
  qpdf --empty --pages "$SRC" "$range" -- "$ROOT/$folder/$filename"
}

